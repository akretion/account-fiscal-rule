<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_ecotax_tax" model="ir.ui.view">
        <field name="name">res.company.form.inherit.ecotax_tax</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <group name="social_media" position="after">
                <group string="Ecotax Taxes" name="ecotax_tax">
                    <field
                        name="ecotax_tax_ids"
                        context="{'default_company_id': id, 'default_is_ecotax': True}"
                    >
                        <list editable="bottom">
                            <field name="name" />
                            <field name="type_tax_use" />
                            <field name="amount" />
                        </list>
                    </field>
                    <button
                        name="action_create_ecotax_tax"
                        type="object"
                        string="Create Ecotax Tax"
                        class="oe_highlight"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
